[Unit]
Description=AerolVM egress gateway control socket
# systemd creates the socket root-owned 0600 and hands the fd to the
# unprivileged gateway; only root (sandboxd) can connect, and the gateway
# still checks SO_PEERCRED (plans/egress-domain-filtering.md CEO D22, S5).

[Socket]
ListenStream=/run/aerolvm/egress-gateway.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755

[Install]
WantedBy=sockets.target
