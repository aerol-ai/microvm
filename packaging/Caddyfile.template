{
    admin localhost:2019
    on_demand_tls {
        ask http://127.0.0.1:8080/v1/tls-check
    }
}

{{ROOT_SITE_ADDRESS}} {
    {{TLS_BLOCK}}
    @api path /health /v1 /v1/*
    reverse_proxy @api 127.0.0.1:8080
    respond "Sandbox API not found" 404
}

{{WILDCARD_SITE_ADDRESS}} {
    {{TLS_BLOCK}}
    respond "Sandbox not found" 404
}