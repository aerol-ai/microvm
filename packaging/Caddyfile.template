# Reference template. The live Caddyfile is generated by scripts/install.sh,
# which picks one of two TLS strategies depending on whether --dns-provider
# is set:
#
#   1. DNS-01 wildcard (recommended for production). Two certs total —
#      $DOMAIN and *.$DOMAIN — covering every present and future sandbox.
#      Sidesteps Let's Encrypt's 50-cert/week-per-registered-domain ceiling.
#
#   2. HTTP-01 on-demand (default when --dns-provider is omitted). One cert
#      per sandbox subdomain, issued lazily on first hit. Rate-limit-bound;
#      do not use past trial-scale deployments.
#
# Substitution placeholders below:
#   {{ROOT_SITE_ADDRESS}}     — the apex domain ($DOMAIN)
#   {{WILDCARD_SITE_ADDRESS}} — *.$DOMAIN
#   {{TLS_BLOCK}}             — either:
#       tls { dns <provider> {env.SB_DNS_API_TOKEN} }    (DNS-01 path)
#     or:
#       tls { on_demand }                                 (HTTP-01 path)
#   {{GLOBAL_TLS_BLOCK}}      — global on_demand_tls ask, only on HTTP-01 path

{
    admin localhost:2019
    {{GLOBAL_TLS_BLOCK}}
}

https://{{ROOT_SITE_ADDRESS}} {
    {{TLS_BLOCK}}
    @api path /health /v1 /v1/*
    handle @api {
        reverse_proxy 127.0.0.1:8080
    }
    handle {
        respond "Sandbox API not found" 404
    }
}

https://{{WILDCARD_SITE_ADDRESS}} {
    {{TLS_BLOCK}}
    respond "Sandbox not found" 404
}