# Firecracker, its jailer and the guest kernel (with its build config) for
# Firecracker pools: the releases scripts/install.sh pins for
# --with-firecracker (k8s_images_test.go keeps them the same). The kernel
# comes from Firecracker's CI bucket, for the CI version named here.
FIRECRACKER_VERSION=v1.15.1
FIRECRACKER_SHA256_AMD64=d4a32ab2322d887ca1bc4a4e7afa9cc35393e6362dfc2b3becb389d362e4275a
