# Third-party binaries in the Kubernetes images (plans/kubernetes-v2-architecture.md
# P1), pinned with the checksum each project publishes, for both CPU types.
# The same versions as the Phase 0 harness (integration-tests/k8s/worker/fetch.sh),
# where they ran the S1-S9 spikes. Bump a version and its hashes together;
# packaging/images/images_test.go checks every entry is here for both.

CONTAINERD_VERSION=2.1.4
CONTAINERD_SHA256_AMD64=50e53500800f4f74d0d8b2e57e939297eab68b0fe11a0957b771d5faa61fae5b
CONTAINERD_SHA256_ARM64=c5f0957064e6ed5a67905ea3f8e451dadd16530334b86baaad678dd357205c30

RUNC_VERSION=v1.3.0
RUNC_SHA256_AMD64=028986516ab5646370edce981df2d8e8a8d12188deaf837142a02097000ae2f2
RUNC_SHA256_ARM64=85c5e4e4f72e442c8c17bac07527cd4f961ee48e4f2b71797f7533c94f4a52b9

CNI_PLUGINS_VERSION=v1.5.1
CNI_PLUGINS_SHA256_AMD64=77baa2f669980a82255ffa2f2717de823992480271ee778aa51a9c60ae89ff9b
CNI_PLUGINS_SHA256_ARM64=c2a292714d0fad98a3491ae43df8ad58354b3c0bdf5d5a3e281777967c70fcff

# gVisor's dated release (gvisor.tar.bz2: runsc, its shim and gvisor-bin/).
GVISOR_RELEASE=20261102.0
GVISOR_SHA512_AMD64=2e6671bb2d033b871c5811ab57e16ac570988b0e0054c525f911cfaf191bab3ca4efb08e0a98daa4b9e7d248f9e5776ef2ef2f8a6b82d829646a42924c98bb05
