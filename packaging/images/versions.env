# The Nitro backend's Firecracker (worker.firecracker.backend: nitro;
# plans/security-gaps-m1-m4.md §4.3): Nitro Sandboxes need v1.18, and the
# KVM backend keeps its own release above (R18), so the image carries both,
# each in its own folder. The guest kernel is an EFI bzImage with
# virtio-pci from Firecracker's CI bucket: the build the Nitro live runs
# booted (6.18.62). That build has no aarch64 EFI kernel, so the Nitro set
# is amd64 only until AerolVM builds its own guest kernel.
FIRECRACKER_NITRO_VERSION=v1.18.0
FIRECRACKER_NITRO_SHA256_AMD64=1ac8eec866dd5eea14efecf6323e22b23eea24054545338a5b34bc5bca6623cd
FIRECRACKER_NITRO_SHA256_ARM64=2a6130ff0338901ff9d7fbd73ce046c6b1c6123889dc84a34d678aa53bd0c0c2
FIRECRACKER_NITRO_KERNEL_CI_PREFIX=firecracker-ci/20261118-6d7cfa9c6b53-0
FIRECRACKER_NITRO_KERNEL_VERSION=6.18.62
FIRECRACKER_NITRO_KERNEL_SHA256_AMD64=a99510ede2f6ae55b1451ee7c5791c29ddef938e3943d1b073e74a2111b64e80
FIRECRACKER_NITRO_KERNEL_CONFIG_SHA256_AMD64=b5a0947b980942e8e60085b979b07476b7b08fc8c9024269bdda79f4473aa8a3

# Mountpoint for Amazon S3 (mount-s3), the s3 mount type's helper, in the
# agent image: AWS's .deb for each CPU type. AWS signs each release with
# GPG (public_keys/KEYS in the release bucket); these hashes are of the
# files whose signatures checked good.
MOUNTPOINT_S3_VERSION=1.24.0
MOUNTPOINT_S3_SHA256_AMD64=410e9e1cf25d45d0b26cb19fa53475ba22f179ae46b636d0345a3cd08a4d4a3b
MOUNTPOINT_S3_SHA256_ARM64=23960d57dc29bcc34ac7ded9e8e6f98c902724d367a3012a48957ef6e2ecca63

# The base images are pinned by digest in each Dockerfile's FROM line,
# where Dependabot keeps them current.
