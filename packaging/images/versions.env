# Cloudflare's workerd, the V8-isolate runtime, in the agent image: the
# release scripts/install.sh pins for --with-isolate (k8s_images_test.go
# keeps the two the same). The hashes are of the .gz release files.
WORKERD_VERSION=v1.20260717.1
WORKERD_SHA256_AMD64=7ff61e052347ab3122c43b1e2419ccd68bd91e3c766f9770320591798e0e89a0
