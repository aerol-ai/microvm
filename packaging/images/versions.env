# Cloudflare's workerd, the V8-isolate runtime, in the agent image: the
# release scripts/install.sh pins for --with-isolate (k8s_images_test.go
# keeps the two the same). The hashes are of the .gz release files.
WORKERD_VERSION=v1.20260717.1
WORKERD_SHA256_AMD64=7ff61e052347ab3122c43b1e2419ccd68bd91e3c766f9770320591798e0e89a0
WORKERD_SHA256_ARM64=3ef71b4a692d2705fa4db0636724409be833402f1c9b99094294a5901989680d

# Firecracker, its jailer and the guest kernel (with its build config) for
# Firecracker pools: the releases scripts/install.sh pins for
# --with-firecracker (k8s_images_test.go keeps them the same). The kernel
# comes from Firecracker's CI bucket, for the CI version named here.
FIRECRACKER_VERSION=v1.15.1
FIRECRACKER_SHA256_AMD64=d4a32ab2322d887ca1bc4a4e7afa9cc35393e6362dfc2b3becb389d362e4275a
FIRECRACKER_SHA256_ARM64=00654ac1e702a22744121ea9f10a4f792ebd7c3a744cba587dfac9fcb79b41a5
FIRECRACKER_KERNEL_CI_VERSION=v1.15
FIRECRACKER_KERNEL_VERSION=5.10.245
FIRECRACKER_KERNEL_SHA256_AMD64=c453f36520d2f2792ab8e4532a814e4a647a4a41a4c94d4e9083a502800159b1
FIRECRACKER_KERNEL_SHA256_ARM64=f88e4f934b8d9c3f3a58a4df24c3cef4e6d94976d34a9360525c008e7e5df0a7
FIRECRACKER_KERNEL_CONFIG_SHA256_AMD64=bccb4a2403d902e1e184e6281270b2b755c6ad6eff1a830c5b8bc788c7b205f8
