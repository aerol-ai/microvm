[
  {
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Search file contents"
    },
    "description": "Find lines containing pattern (plain text, not a regex) in files under path. Returns up to 200 matches as {file, line, content}.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "directory to search (default: the working directory)",
          "type": "string"
        },
        "pattern": {
          "description": "text to find (plain text, not a regex)",
          "type": "string"
        },
        "sandbox": {
          "description": "the sandbox's ID or name",
          "type": "string"
        }
      },
      "required": [
        "sandbox",
        "pattern"
      ],
      "type": "object"
    },
    "name": "grep_files",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "matches": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              }
            },
            "required": [
              "file",
              "line",
              "content"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "notice": {
          "type": "string"
        },
        "sandbox_created": {
          "type": "boolean"
        },
        "sandbox_recreated": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "matches"
      ],
      "type": "object"
    }
  },
