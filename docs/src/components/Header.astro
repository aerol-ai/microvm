---
import { comparePaths, isActiveOrParentPath } from '../utils/navigation'

const currentPath = Astro.url.pathname
const version = import.meta.env.VERSION || '0.1.1'

const navLinks = [
  { href: '/', label: 'Docs', exact: true },
  { href: '/getting-started', label: 'Getting Started' },
]

const isActive = link =>
  link.exact ? comparePaths(link.href, currentPath) : isActiveOrParentPath(link.href, currentPath)

const languages = ['TypeScript', 'Python', 'Go', 'Rust', 'Java']
---

<script is:inline>
  (function () {
    var LANG_KEY = 'aerolvm-lang';
    var SL_KEY = 'starlight-synced-tabs__lang';
    var LANGS = ['TypeScript', 'Python', 'Go', 'Rust', 'Java'];

    var saved = localStorage.getItem(LANG_KEY) || 'TypeScript';
    sessionStorage.setItem(SL_KEY, saved);

    function syncPicker(lang) {
      var picker = document.getElementById('lang-picker');
      if (picker) picker.value = lang;
    }

    function triggerTabSync(lang) {
      localStorage.setItem(LANG_KEY, lang);
      sessionStorage.setItem(SL_KEY, lang);
      var firstGroup = document.querySelector('starlight-tabs');
      if (firstGroup) {
        var buttons = firstGroup.querySelectorAll('[role="tab"]');
        for (var i = 0; i < buttons.length; i++) {
          if (buttons[i].textContent.trim() === lang) {
            buttons[i].click();
            break;
          }
        }
      }
    }

    function onReady() {
      syncPicker(saved);

      var picker = document.getElementById('lang-picker');
      if (!picker) return;

      picker.addEventListener('change', function () {
        triggerTabSync(picker.value);
      });

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[role="tab"]');
        if (!btn) return;
        var label = btn.textContent.trim();
        if (LANGS.indexOf(label) !== -1 && picker.value !== label) {
          picker.value = label;
          localStorage.setItem(LANG_KEY, label);
        }
      });
    }

    document.addEventListener('DOMContentLoaded', onReady);
    document.addEventListener('astro:page-load', function () {
      var lang = sessionStorage.getItem(SL_KEY) || localStorage.getItem(LANG_KEY) || 'TypeScript';
      sessionStorage.setItem(SL_KEY, lang);
      syncPicker(lang);
    });
  })();
</script>

<header class="navbar">
  <nav class="desktop-only">
    <a href={import.meta.env.BASE_URL} aria-label="AerolVM" class="brand-lockup">
      <span class="brand-mark">
        <img src={`${import.meta.env.BASE_URL}aerol-logo.svg`} alt="Aerol" width="18" height="20" />
      </span>
      <span class="brand-copy">
        <span class="brand-name">AerolVM</span>
        <span class="brand-subtitle">Sandbox Platform</span>
      </span>
    </a>
    <div class="navbar-links">
      {
        navLinks.map(link => (
          <a
            href={link.href}
            class:list={{ active: !link.external && isActive(link) }}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="nav__items_side_menu">
      <div class="lang-picker-wrap">
        <select id="lang-picker" class="lang-picker" aria-label="Select SDK language">
          {languages.map(lang => <option value={lang}>{lang}</option>)}
        </select>
      </div>
      <span class="version-pill">{version}</span>
      <a class="github-link" href="https://github.com/aerol-ai/microvm" target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
    </div>
  </nav>

  <nav class="mobile-navigation">
    <a href={import.meta.env.BASE_URL} aria-label="AerolVM" class="brand-lockup">
      <span class="brand-mark">
        <img src={`${import.meta.env.BASE_URL}aerol-logo.svg`} alt="Aerol" width="18" height="20" />
      </span>
      <span class="brand-copy">
        <span class="brand-name">AerolVM</span>
        <span class="brand-subtitle">Docs</span>
      </span>
    </a>
  </nav>
</header>