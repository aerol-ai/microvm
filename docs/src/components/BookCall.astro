---
// A "talk to us" box for docs pages. Starlight's LinkButton takes its label
// color from Starlight's own palette, which this theme never sets, so its text
// rendered dark on a dark accent. This one uses the site's color tokens and
// stays readable in both themes.
interface Props {
  href: string
  title: string
  label?: string
}

const { href, title, label = 'Book a call' } = Astro.props
---

<div class="book-call not-content">
  <div class="book-call__text">
    <p class="book-call__title">{title}</p>
    <div class="book-call__body"><slot /></div>
  </div>
  <a class="book-call__button" href={href} target="_blank" rel="noopener noreferrer">
    {label}
    <span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .book-call {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 1.75rem 0;
    padding: 20px 24px;
    background: var(--block-bg-color);
    border: var(--border);
  }

  .book-call__title {
    margin: 0;
    font-weight: 600;
    color: var(--primary-text-color);
  }

  .book-call__body {
    margin-top: 4px;
    font-size: 0.95rem;
    color: var(--secondary-text-color);
  }

  .book-call__body :global(p) {
    margin: 0;
  }

  .book-call__button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--primary-text-color);
    color: var(--bg-color);
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .book-call__button:hover {
    background: var(--hover-color);
    color: var(--bg-color);
  }

  @media (max-width: 640px) {
    .book-call {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
