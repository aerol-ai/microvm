---
import TableOfContentsList from './TableOfContentsList.astro'

const { toc } = Astro.locals.starlightRoute
---

{
  toc && (
    <starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
      <nav class="desktop-toc" aria-labelledby="starlight__on-this-page">
        <h2 id="starlight__on-this-page" class="table-of-contents-title">
          # On this page
        </h2>
        <TableOfContentsList toc={toc.items} />
      </nav>

      <div class="mobile-toc">
        <button class="mobile-toc-tab" aria-expanded="false" aria-label="On this page">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="15" y2="18" />
          </svg>
        </button>
        <div class="mobile-toc-backdrop" hidden />
        <div class="mobile-toc-drawer" hidden>
          <div class="mobile-toc-drawer-header">
            <span class="mobile-toc-drawer-title"># On this page</span>
            <button class="mobile-toc-close" aria-label="Close">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
          <div class="mobile-toc-drawer-content">
            <TableOfContentsList toc={toc.items} isMobile={true} />
          </div>
        </div>
      </div>
    </starlight-toc>
  )
}

<script>
  const wrapper = document.querySelector('.mobile-toc')
  if (wrapper) {
    const tab = wrapper.querySelector<HTMLButtonElement>('.mobile-toc-tab')
    const drawer = wrapper.querySelector<HTMLElement>('.mobile-toc-drawer')
    const backdrop = wrapper.querySelector<HTMLElement>('.mobile-toc-backdrop')
    const closeBtn = wrapper.querySelector<HTMLButtonElement>('.mobile-toc-close')

    function close() {
      if (drawer) drawer.hidden = true
      if (backdrop) backdrop.hidden = true
      if (tab) tab.setAttribute('aria-expanded', 'false')
      document.body.removeAttribute('data-toc-expanded')
    }

    function open() {
      if (drawer) drawer.hidden = false
      if (backdrop) backdrop.hidden = false
      if (tab) tab.setAttribute('aria-expanded', 'true')
      document.body.setAttribute('data-toc-expanded', 'true')
    }

    tab?.addEventListener('click', () => {
      tab.getAttribute('aria-expanded') === 'true' ? close() : open()
    })

    closeBtn?.addEventListener('click', close)
    backdrop?.addEventListener('click', close)

    drawer?.querySelectorAll('a').forEach(a => a.addEventListener('click', close))

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') close()
    })

    document.addEventListener('astro:page-load', close)
  }
</script>

<style>
  .desktop-toc {
    text-align: left;
  }

  .table-of-contents-title {
    margin: 0 0 0.75rem;
    color: var(--primary-text-color);
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
    text-align: left;
  }

  .mobile-toc {
    display: none;
  }

  @media (max-width: 1024px) {
    .desktop-toc {
      display: none;
    }

    .mobile-toc {
      display: block;
    }

    /* Left-side tab button */
    .mobile-toc-tab {
      position: fixed;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      z-index: 22;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 52px;
      padding: 0;
      background-color: var(--bg-color);
      border: var(--border);
      border-left: none;
      border-radius: 0 8px 8px 0;
      color: var(--secondary-text-color);
      cursor: pointer;
      box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
      transition: color 0.15s ease, box-shadow 0.15s ease;
    }

    .mobile-toc-tab:hover {
      color: var(--primary-text-color);
      box-shadow: 3px 0 12px rgba(0, 0, 0, 0.25);
    }

    /* Backdrop */
    .mobile-toc-backdrop {
      position: fixed;
      inset: 0;
      z-index: 23;
      background-color: rgba(11, 17, 22, 0.5);
      backdrop-filter: blur(2px);
    }

    /* Left-side drawer */
    .mobile-toc-drawer {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 24;
      width: 75vw;
      max-width: 300px;
      background-color: var(--bg-color);
      border-right: 1px solid var(--border-extra);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .mobile-toc-drawer[hidden] {
      display: none;
    }

    .mobile-toc-drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 16px 12px;
      border-bottom: 1px solid var(--border-extra);
      flex-shrink: 0;
    }

    .mobile-toc-drawer-title {
      color: var(--primary-text-color);
      font-family: var(--font-sans);
      font-size: 0.9375rem;
      font-weight: 600;
    }

    .mobile-toc-close {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6px;
      background: none;
      border: none;
      color: var(--secondary-text-color);
      cursor: pointer;
      border-radius: 6px;
    }

    .mobile-toc-close:hover {
      color: var(--primary-text-color);
      background-color: var(--block-bg-color);
    }

    .mobile-toc-drawer-content {
      padding: 12px 8px;
      overflow-y: auto;
      flex: 1;
    }
  }
</style>
