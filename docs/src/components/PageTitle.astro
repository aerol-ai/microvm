---
import { PAGE_TITLE_ID } from './TableOfContent/constants'

const { entry } = Astro.props
---

{
  !entry.data.hideTitleOnPage && <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
}
{
  entry.data.description && <p class="page-intro">{entry.data.description}</p>
}

<style>
  .page-intro {
    margin-top: -28px;
    margin-bottom: 24px;
    max-width: 68ch;
    color: var(--accent-text-color);
    font-size: 1.05rem;
  }
</style>