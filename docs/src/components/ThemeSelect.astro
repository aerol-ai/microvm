<theme-select class="theme-select-container">
  <button type="button" id="dark" aria-label="Dark theme">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M14.5 3.5A8.5 8.5 0 1 0 20.5 16 7 7 0 1 1 14.5 3.5Z" fill="currentColor"></path>
    </svg>
  </button>
  <button type="button" id="light" aria-label="Light theme">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
      <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17 4.9 19.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
  </button>
  <button type="button" id="auto" aria-label="System theme">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7A2.5 2.5 0 0 1 17.5 16H13l-4 4v-4H6.5A2.5 2.5 0 0 1 4 13.5v-7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    </svg>
  </button>
</theme-select>

<script is:inline>
  ThemeProvider.updatePickers()
</script>

<script>
  class ThemeSelect extends HTMLElement {
    #key = 'theme'

    constructor() {
      super()
      this.#onThemeChange(this.#loadTheme())
      this.querySelectorAll('button').forEach(button => {
        button.addEventListener('click', () => {
          this.#onThemeChange(button.id)
        })
      })
    }

    #parseTheme(theme) {
      if (theme === 'auto' || theme === 'dark' || theme === 'light') {
        return theme
      }

      return 'auto'
    }

    #preferredTheme() {
      return matchMedia('(prefers-color-scheme: light)').matches
        ? 'light'
        : 'dark'
    }

    #onThemeChange(theme) {
      const nextTheme = this.#parseTheme(theme)
      ThemeProvider.updatePickers(nextTheme)
      document.documentElement.dataset.theme =
        nextTheme === 'auto' ? this.#preferredTheme() : nextTheme
      this.#storeTheme(nextTheme)
    }

    #storeTheme(theme) {
      if (typeof localStorage === 'undefined') {
        return
      }

      if (theme === 'light' || theme === 'dark') {
        localStorage.setItem(this.#key, theme)
      } else {
        localStorage.removeItem(this.#key)
      }
    }

    #loadTheme() {
      const theme =
        typeof localStorage !== 'undefined' && localStorage.getItem(this.#key)
      return this.#parseTheme(theme)
    }
  }

  customElements.define('theme-select', ThemeSelect)
</script>

<style>
  .theme-select-container {
    display: flex;
    text-align: center;
    gap: 4px;
  }

  .theme-select-container button {
    background: none;
    border: none;
    padding: 4px;
    display: flex;
    align-items: center;
    cursor: pointer;
    color: var(--primary-text-color);
    border-radius: 4px;
  }

  .theme-select-container button:hover,
  .theme-select-container .theme-select-button-active {
    background: var(--block-bg-color);
    border-radius: 3px;
    color: var(--primary-text-color);
  }

  .theme-select-container svg {
    width: 16px;
    height: 16px;
  }
</style>