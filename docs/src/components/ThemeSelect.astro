<theme-select class="theme-select-container">
  <span class="theme-select-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <path d="M12 3.25a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V4a.75.75 0 0 1 .75-.75ZM12 18.5a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V19.25a.75.75 0 0 1 .75-.75ZM5.813 5.813a.75.75 0 0 1 1.06 0l1.061 1.06a.75.75 0 1 1-1.06 1.061L5.812 6.873a.75.75 0 0 1 0-1.06ZM16.066 16.065a.75.75 0 0 1 1.06 0l1.061 1.061a.75.75 0 0 1-1.06 1.06l-1.061-1.06a.75.75 0 0 1 0-1.061ZM3.25 12a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5H4a.75.75 0 0 1-.75-.75ZM18.5 12a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1-.75-.75ZM6.873 16.065a.75.75 0 0 1 1.06 1.061l-1.06 1.06a.75.75 0 0 1-1.061-1.06l1.061-1.061ZM17.126 5.813a.75.75 0 0 1 1.06 1.06l-1.06 1.061a.75.75 0 1 1-1.061-1.06l1.061-1.061ZM12 8a4 4 0 1 1 0 8a4 4 0 0 1 0-8Z" fill="currentColor"></path>
    </svg>
  </span>
  <select aria-label="Theme">
    <option value="auto">System</option>
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>
</theme-select>

<script is:inline>
  ThemeProvider.updatePickers()
</script>

<script>
  class ThemeSelect extends HTMLElement {
    #key = 'theme'

    constructor() {
      super()
      this.select = this.querySelector('select')
      this.#onThemeChange(this.#loadTheme())
      if (this.select) {
        this.select.addEventListener('change', () => {
          this.#onThemeChange(this.select.value)
        })
      }
    }

    #parseTheme(theme) {
      if (theme === 'auto' || theme === 'dark' || theme === 'light') {
        return theme
      }

      return 'auto'
    }

    #preferredTheme() {
      return matchMedia('(prefers-color-scheme: light)').matches
        ? 'light'
        : 'dark'
    }

    #onThemeChange(theme) {
      const nextTheme = this.#parseTheme(theme)
      ThemeProvider.updatePickers(nextTheme)
      if (this.select) {
        this.select.value = nextTheme
      }
      document.documentElement.dataset.theme =
        nextTheme === 'auto' ? this.#preferredTheme() : nextTheme
      this.#storeTheme(nextTheme)
    }

    #storeTheme(theme) {
      if (typeof localStorage === 'undefined') {
        return
      }

      if (theme === 'light' || theme === 'dark') {
        localStorage.setItem(this.#key, theme)
      } else {
        localStorage.removeItem(this.#key)
      }
    }

    #loadTheme() {
      const theme =
        typeof localStorage !== 'undefined' && localStorage.getItem(this.#key)
      return this.#parseTheme(theme)
    }
  }

  if (!customElements.get('theme-select')) {
    customElements.define('theme-select', ThemeSelect)
  }
</script>

<style>
  .theme-select-container {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: var(--border);
    border-radius: 999px;
    background: var(--bg-color);
    flex-shrink: 0;
    color: var(--primary-text-color);
    position: relative;
  }

  .theme-select-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .theme-select-container::after {
    content: '';
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-35%);
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid currentColor;
    pointer-events: none;
  }

  .theme-select-container svg {
    width: 16px;
    height: 16px;
  }

  .theme-select-container select {
    appearance: none;
    border: none;
    background: transparent;
    color: inherit;
    padding: 0 20px 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    outline: none;
  }

  .theme-select-container select:hover,
  .theme-select-container select:focus {
    color: var(--hover-color);
  }

  .theme-select-container option {
    color: var(--primary-text-color);
    background: var(--bg-color);
  }
</style>