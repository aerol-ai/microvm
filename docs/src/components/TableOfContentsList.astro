---
const { toc = [], depth = 0, isMobile = false } = Astro.props
---

<ul class:list={{ isMobile }}>
  {
    toc.map(heading => (
      <li>
        <a href={`#${heading.slug}`} style={`padding-left: ${depth * 8}px;`}>
          <span>{heading.text}</span>
        </a>
        {
          heading.children.length > 0 && (
            <Astro.self toc={heading.children} depth={depth + 1} isMobile={isMobile} />
          )
        }
      </li>
    ))
  }
</ul>

<style>
  ul {
    padding: 0;
    list-style: none;
    row-gap: 4px;
  }

  a {
    color: var(--secondary-text-color);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.015rem;
    margin-bottom: 8px;
    transition: color 0.1s ease-in-out;
  }

  a:hover {
    text-decoration: underline;
    color: var(--primary-text-color) !important;
    text-decoration-color: var(--hover-color) !important;
    text-underline-offset: 3.2px;
  }

  a[aria-current='true'] {
    color: var(--primary-text-color) !important;
  }
</style>