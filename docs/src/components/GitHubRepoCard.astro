---
// The repo link pinned under the left navigation. PageFrame keeps it outside
// the scrolling list, so it stays at the bottom of the column.
import { formatStars, getStars, GITHUB_REPO } from '../utils/githubStars'

const stars = await getStars()
---

<a
  class="github-repo-card"
  href={`https://github.com/${GITHUB_REPO}`}
  target="_blank"
  rel="noreferrer"
  data-repo={GITHUB_REPO}
>
  <svg class="github-repo-card__icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"></path>
  </svg>
  <span class="github-repo-card__text">
    <span class="github-repo-card__name">{GITHUB_REPO}</span>
    <span class="github-repo-card__stars">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
      </svg>
      <span class="github-repo-card__count">{stars === null ? 'Star on GitHub' : formatStars(stars)}</span>
    </span>
  </span>
</a>

<script>
  import { formatStars } from '../utils/githubStars'

  // Refresh the build-time count, at most once an hour per reader, so it does
  // not go stale between deploys. The cache is only a convenience: if storage
  // is blocked, the count is simply fetched again.
  const card = document.querySelector<HTMLElement>('.github-repo-card')
  const count = card?.querySelector('.github-repo-card__count')
  const repo = card?.dataset.repo
  const key = `github-stars:${repo}`
  const maxAge = 60 * 60 * 1000

  function show(stars: number) {
    if (count) count.textContent = formatStars(stars)
  }

  async function refresh() {
    try {
      const cached = JSON.parse(localStorage.getItem(key) || 'null')
      if (cached && Date.now() - cached.at < maxAge && typeof cached.stars === 'number') return show(cached.stars)
    } catch {
      // Blocked or corrupt storage: fall through to the API.
    }
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: 'application/vnd.github+json' } })
      if (!res.ok) return
      const { stargazers_count: stars } = await res.json()
      if (typeof stars !== 'number') return
      show(stars)
      try {
        localStorage.setItem(key, JSON.stringify({ stars, at: Date.now() }))
      } catch {
        // Not saved; the next page fetches again.
      }
    } catch {
      // Offline or rate limited: keep the build-time number.
    }
  }

  if (card && repo) refresh()
</script>

<style>
  .github-repo-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: var(--border);
    border-radius: 8px;
    background: var(--block-bg-color);
    color: var(--primary-text-color);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .github-repo-card:hover {
    border-color: var(--hover-color);
  }

  .github-repo-card__icon {
    flex-shrink: 0;
  }

  .github-repo-card__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .github-repo-card__name {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .github-repo-card__stars {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--secondary-text-color);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  .github-repo-card__stars svg {
    color: var(--yellow-code-text);
  }
</style>
