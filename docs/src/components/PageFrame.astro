---
import MobileMenuToggle from './MobileMenuToggle.astro'

const { hasSidebar = true } = Astro.props
---

<div class={`page sl-flex ${!hasSidebar ? 'no-sidebar' : ''}`}>
  <div class="header-wrapper"><slot name="header" /></div>
  <div class="grid-template">
    {
      hasSidebar && (
        <nav class="sidebar" aria-label="Sidebar navigation">
          <MobileMenuToggle {...Astro.props} />
          <div id="starlight__sidebar" class="sidebar-pane">
            <div class="sidebar-content sl-flex">
              <slot name="sidebar" />
            </div>
          </div>
        </nav>
      )
    }
    <div class="main-frame"><slot /></div>
  </div>
</div>

<script is:inline>
  ;(() => {
    try {
      if (!matchMedia('(min-width: 50em)').matches) return
      const scroller = document.getElementById('starlight__sidebar')
      const state = JSON.parse(sessionStorage.getItem('sl-sidebar-state') || '0')
      if (!scroller || !state) return
      scroller.scrollTop = state.scroll
    } catch {}
  })()
</script>

<style>
  .grid-template {
    position: relative;
    display: grid;
    grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
    column-gap: 20px;
  }

  .no-sidebar .grid-template {
    grid-template-columns: 100%;
  }

  .header-wrapper {
    position: sticky;
    z-index: 4;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    background-color: var(--bg-color);
  }

  .sidebar-pane {
    visibility: visible;
    position: sticky;
    inset-block: 0;
    width: 100%;
    background-color: var(--bg-color);
    overflow-y: auto;
    overscroll-behavior: contain;
    max-height: calc(100vh - 75px);
    top: 75px;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 30px,
      black calc(100% - 30px),
      transparent 100%
    );
  }

  .sidebar-content {
    min-height: max-content;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 1024px) {
    .grid-template {
      grid-template-columns: 100%;
    }

    .sidebar-pane {
      display: none;
      z-index: 20;
      padding-top: 72px;
      position: fixed;
      right: 0;
      width: 75vw;
      border-left: 1px solid var(--border-extra);
      padding-left: 20px;
      padding-right: 20px;
      top: 0;
      bottom: 0;
      height: 100vh;
      max-height: unset;
    }

    :global(body[data-mobile-menu-expanded]) .sidebar-pane {
      display: block;
    }

    .main-frame {
      padding-top: 48px;
    }
  }
</style>