---
import ThemeSelect from './ThemeSelect.astro'
---

<footer class="docs-footer__container">
  <div class="docs-footer__container__support-links">
    <p>
      Source: <a href="https://github.com/aerol-ai/microvm" target="_blank" rel="noreferrer">github.com/aerol-ai/microvm</a>
    </p>
    <p>
      SDKs: <a href="https://github.com/aerol-ai/microvm/tree/main/sdk" target="_blank" rel="noreferrer">Go, TypeScript, Python, Java, and Rust</a>
    </p>
  </div>

  <div class="docs-footer__container__bottom">
    <div class="docs-footer__container__bottom-block">
      <div><p>© {new Date().getFullYear()} Sandbox Library</p></div>
      <div class="divider"></div>
    </div>

    <div class="footer-selects">
      <ThemeSelect />
    </div>

    <div class="menu-list">
      <a href="https://github.com/aerol-ai/microvm/issues" target="_blank" rel="noreferrer">Issues</a>
      <a href="https://github.com/aerol-ai/microvm/tree/main/sdk" target="_blank" rel="noreferrer">SDKs</a>
    </div>
  </div>
</footer>

<style>
  .footer-selects {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    align-items: center;
    order: 2;
    margin-left: auto;
  }
</style>