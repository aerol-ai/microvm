        },
        "definition": "label_values(owner:aerolvm_usage_reserved_cpu_seconds:rate5m{aerolvm_cluster=~\"$cluster\"}, owner)",
        "query": {
          "query": "label_values(owner:aerolvm_usage_reserved_cpu_seconds:rate5m{aerolvm_cluster=~\"$cluster\"}, owner)",
          "refId": "owner"
        },
        "current": {
          "selected": true,
