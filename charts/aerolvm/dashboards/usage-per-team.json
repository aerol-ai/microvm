{
  "annotations": {
    "list": []
  },
  "description": "CPU and memory reserved (the charge) and consumed, per team, from the workers' usage counters (C20). From the AerolVM Helm chart (monitoring.enabled).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Reserved** is the charge: each sandbox's CPU and memory limit, for the time it ran. **Consumed** is what the sandboxes really used. It is shown next to the charge and never changes it. The graphs show CPUs and MiB held on average. They are not money: your cost tool splits each worker pod's cost by these shares. A team with no name is the main API token."
      }
    },
    {
      "type": "timeseries",
      "title": "Reserved CPU by team (CPUs held)",
      "description": "",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (owner:aerolvm_usage_reserved_cpu_seconds:rate5m{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"})",
          "legendFormat": "{{owner}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumed CPU by team (CPUs used)",
      "description": "",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (owner:aerolvm_usage_consumed_cpu_seconds:rate5m{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"})",
          "legendFormat": "{{owner}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reserved memory by team",
      "description": "",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (owner:aerolvm_usage_reserved_memory_mib_seconds:rate5m{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"})",
          "legendFormat": "{{owner}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumed memory by team",
      "description": "",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (owner:aerolvm_usage_consumed_memory_mib_seconds:rate5m{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"})",
          "legendFormat": "{{owner}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU used out of CPU reserved, by team",
      "description": "Low means a team reserves much more than it uses.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (owner:aerolvm_usage_consumed_cpu_seconds:rate5m{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"}) / sum by (owner) (owner:aerolvm_usage_reserved_cpu_seconds:rate5m{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"} > 0)",
          "legendFormat": "{{owner}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory used out of memory reserved, by team",
      "description": "",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (owner:aerolvm_usage_consumed_memory_mib_seconds:rate5m{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"}) / sum by (owner) (owner:aerolvm_usage_reserved_memory_mib_seconds:rate5m{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"} > 0)",
          "legendFormat": "{{owner}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Totals for the time range",
      "description": "Added up from the raw counters over the dashboard's time range, across every worker and restart.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "CPU-hours reserved"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (increase(aerolvm_usage_reserved_cpu_seconds_total{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"}[$__range])) / 3600",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (increase(aerolvm_usage_consumed_cpu_seconds_total{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"}[$__range])) / 3600",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (increase(aerolvm_usage_reserved_memory_mib_seconds_total{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"}[$__range])) / 3600 / 1024",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (owner) (increase(aerolvm_usage_consumed_memory_mib_seconds_total{aerolvm_cluster=~\"$cluster\", owner=~\"$owner\"}[$__range])) / 3600 / 1024",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "owner": "Team",
              "Value #B": "CPU-hours used",
              "Value #C": "GiB-hours reserved",
              "Value #D": "GiB-hours used",
              "Value #A": "CPU-hours reserved"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Each team's share of each worker pod's CPU (needs kube-state-metrics)",
      "description": "Step 1 of the cost split in the Kubernetes docs: the team's reserved CPU-seconds on the pod, divided by the larger of all teams' and the pod's CPU request times the time range. What is left is idle.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "CPU share"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod, owner) (increase(aerolvm_usage_reserved_cpu_seconds_total{aerolvm_cluster=~\"$cluster\"}[$__range])) / on (namespace, pod) group_left () ((sum by (namespace, pod) (increase(aerolvm_usage_reserved_cpu_seconds_total{aerolvm_cluster=~\"$cluster\"}[$__range])) >= on (namespace, pod) $__range_s * sum by (namespace, pod) (kube_pod_container_resource_requests{resource=\"cpu\"})) or on (namespace, pod) $__range_s * sum by (namespace, pod) (kube_pod_container_resource_requests{resource=\"cpu\"}))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Worker pod",
              "owner": "Team",
              "Value": "CPU share"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Age of each worker's usage counters",
      "description": "Above 10 minutes, that worker's usage is missing (AerolVMUsageExporterStale).",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (namespace, pod) (aerolvm_usage_last_sample_timestamp_seconds{aerolvm_cluster=~\"$cluster\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cgroup readings that failed",
      "description": "Each failed reading leaves a gap in consumed use, never in the charge.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(aerolvm_usage_consumed_read_failures_total{aerolvm_cluster=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "aerolvm",
    "kubernetes"
