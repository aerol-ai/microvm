#!/bin/bash
###############################################################################
# AerolVM node bootstrap (rendered from Terraform).
#
# Variables expected:
#   node_name, role, is_seed (bool),
#   pat_token, domain, cloudflare_api_token,
#   with_firecracker (bool), with_gvisor (bool), with_isolate (bool), with_nvidia_gpu (bool), with_amd_gpu (bool),
#   idle_timeout_min (number; 0 disables),
#   firecracker_binary_url, firecracker_jailer_url, firecracker_kernel_url,
#   firecracker_kernel_config_url, firecracker_auto_install,
#   firecracker_version, firecracker_upstream_arch,
#   firecracker_kernel_ci_version, firecracker_kernel_version,
#   firecracker_binary_path, firecracker_jailer_path, firecracker_kernel_path,
#   firecracker_run_dir, firecracker_templates_dir,
#   firecracker_use_jailer, firecracker_jailer_chroot_base,
#   firecracker_jailer_uid, firecracker_jailer_gid,
#   firecracker_tap_base_cidr, firecracker_tap_pool_size,
#   firecracker_skopeo_bin, firecracker_umoci_bin, firecracker_mkfs_bin,
#   firecracker_ip_binary, firecracker_template_gc_enabled,
#   firecracker_template_gc_interval, firecracker_template_gc_ttl,
#   firecracker_snapshot_enabled, firecracker_template_build_timeout,
#   firecracker_template_rotation_interval, firecracker_template_max_age,
#   firecracker_template_memory_mb, firecracker_template_vcpu,
#   firecracker_snapshot_verify_on_load, firecracker_overlay_enabled,
#   firecracker_overlay_mkfs, firecracker_snapshot_post_resume_timeout,
#   firecracker_vmm_pool_enabled, firecracker_vmm_pool_depth_default,
#   firecracker_vmm_pool_gc_interval, firecracker_vmm_pool_gc_ttl,
#   firecracker_vmm_pool_refill_interval, firecracker_rss_sampler_interval,
#   firecracker_rss_watermark_ratio,
#   bundle_bucket, aws_region, seed_private_ip,
#   install_script_url, caddy_binary_url,
#   cluster_init_script_url, cluster_join_script_url,
#   cluster_sign_node_script_url (seed only),
#   sandboxd_url, toolboxd_url, checksums_url,
#   joiner_role_unique_id, sandboxd_env (map),
#   seed_wait_max_seconds, extra_user_data
#
# Order of operations matches the scripts' contracts:
#   1. install.sh first  — sets up sandboxd + Caddy + (optionally) DNS-01 TLS.
#                          Required by cluster-init/join (they check for
#                          /etc/sandboxd/sandboxd.env and the systemd unit).
#   2. cluster-init OR cluster-join — flips the daemon into cluster mode.
###############################################################################
set -euxo pipefail
exec > >(tee -a /var/log/aerolvm-bootstrap.log) 2>&1

echo "[bootstrap] node=${node_name} role=${role} seed=${is_seed}"

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y curl jq awscli openssl ca-certificates

curl_download() {
  local url="$1"
  shift
  curl -fsSL \
    --retry 60 \
    --retry-delay 5 \
    --retry-all-errors \
    --retry-max-time 900 \
    --retry-connrefused \
    --connect-timeout 20 \
    --max-time 300 \
    --speed-limit 1024 \
    --speed-time 30 \
    "$url" "$@"
}

%{ if aocr_enabled && aocr_mirror_host != "" ~}
###############################################################################
# 0. Docker Hub mirror (AOCR) — day-0 daemon.json
#
# Sandboxd's client-side rewriter handles ghcr.io / gcr.io / quay.io /
# registry.k8s.io by URL substitution, but Docker Hub is special: dockerd
# *only* honours a mirror for Hub via /etc/docker/daemon.json
# `registry-mirrors`. Without this block, `docker pull alpine` bypasses
# the AOCR mirror entirely (same name "library/alpine" exists upstream).
#
# Written before install.sh so dockerd starts with the setting on its
# very first boot — no restart-races, no containers to evict.
# `live-restore: true` is set proactively so future daemon restarts
# (cert rotation, package upgrades) don't kill running sandboxes.
#
# jq-merges into any pre-existing daemon.json (e.g. baked into a custom
# AMI) instead of clobbering it.
###############################################################################
install -d -m 0755 /etc/docker
if [ -s /etc/docker/daemon.json ]; then
  jq --arg mirror "https://${aocr_mirror_host}" \
     '. + {"registry-mirrors": [$mirror], "live-restore": true}' \
     /etc/docker/daemon.json > /etc/docker/daemon.json.new
else
  jq -n --arg mirror "https://${aocr_mirror_host}" \
     '{"registry-mirrors": [$mirror], "live-restore": true}' \
     > /etc/docker/daemon.json.new
fi
mv /etc/docker/daemon.json.new /etc/docker/daemon.json
chmod 0644 /etc/docker/daemon.json
# Restart only if dockerd is already running (custom AMI); otherwise
# install.sh will start it and pick the config up on its first boot.
if systemctl is-active --quiet docker; then
  systemctl restart docker
fi
%{ endif ~}

###############################################################################
# 1. install.sh
#
# Wildcard DNS-01 TLS requires --domain + --dns-provider cloudflare +
# --dns-api-token. The Cloudflare token we already use for the cloudflare
# provider (Zone:DNS:Edit on the zone) is the right scope. Without all three
# install.sh runs in IP/path mode with no TLS, and the cluster's public URLs
# fall back to http://<ip>/<id>/.
###############################################################################
curl_download '${install_script_url}' -o /tmp/install.sh
chmod +x /tmp/install.sh

INSTALL_ARGS=(--pat-token '${pat_token}' --node-name '${node_name}')
if [ -n '${domain}' ]; then
  INSTALL_ARGS+=(
    --domain '${domain}'
    --dns-provider cloudflare
    --dns-api-token '${cloudflare_api_token}'
  )
else
  # No domain => local-mode install: no Caddy, no DNS-01 TLS, API bound on
  # localhost:21212. Used by the integration harness's local-mode scenario,
  # which reaches the box over an SSH tunnel. Prod/cluster always set a domain,
  # so this branch never fires for them.
  INSTALL_ARGS+=(--local)
fi
# Register an ACME contact email so Let's Encrypt can notify on cert expiry,
# revocation, and rate-limit triage. Empty string => omit the flag and Caddy
# falls back to an anonymous account (no notifications).
if [ -n '${acme_email}' ]; then
  INSTALL_ARGS+=(--acme-email '${acme_email}')
fi
%{ if caddy_binary_url != "" ~}
INSTALL_ARGS+=(--caddy-binary-url '${caddy_binary_url}')
%{ endif ~}
%{ if sandboxd_url != "" ~}
# Locally-built artifacts (integration harness only; empty in production).
# install.sh derives each asset name with basename "$${URL%%\?*}", so the
# presigned query string is stripped and checksums.txt still matches by name.
INSTALL_ARGS+=(
  --sandboxd-url '${sandboxd_url}'
  --toolboxd-url '${toolboxd_url}'
  --checksums-url '${checksums_url}'
)
%{ endif ~}
%{ if with_gvisor ~}
INSTALL_ARGS+=(--with-gvisor)
%{ endif ~}
%{ if with_isolate ~}
INSTALL_ARGS+=(--with-isolate)
%{ endif ~}
%{ if with_nvidia_gpu ~}
INSTALL_ARGS+=(--with-nvidia-gpu)
%{ endif ~}
%{ if with_amd_gpu ~}
INSTALL_ARGS+=(--with-amd-gpu)
%{ endif ~}
%{ if idle_timeout_min > 0 ~}
INSTALL_ARGS+=(--idle-timeout-min '${idle_timeout_min}')
%{ endif ~}
%{ if caddy_storage_s3_enabled ~}
# Shared S3-backed Caddy cert storage. Every node points at the same
# bucket; certmagic-s3 holds a distributed lock during ACME so only the
# leader issues / renews. encryption_key must match across every node
# or readers can't decrypt what the leader wrote. See
# setup/multi-node-cert-sharing.md for the operator-level explanation.
INSTALL_ARGS+=(
  --caddy-storage-s3
  --caddy-storage-s3-bucket '${caddy_storage_s3_bucket}'
  --caddy-storage-s3-region '${caddy_storage_s3_region}'
  --caddy-storage-s3-prefix '${caddy_storage_s3_prefix}'
  --caddy-storage-s3-encryption-key '${caddy_storage_s3_encryption_key}'
)
%{ if caddy_storage_s3_endpoint != "" ~}
INSTALL_ARGS+=(--caddy-storage-s3-endpoint '${caddy_storage_s3_endpoint}')
%{ endif ~}
%{ if caddy_storage_s3_access_key != "" ~}
INSTALL_ARGS+=(
  --caddy-storage-s3-access-key '${caddy_storage_s3_access_key}'
  --caddy-storage-s3-secret-key '${caddy_storage_s3_secret_key}'
)
%{ endif ~}
%{ endif ~}

sudo /tmp/install.sh "$${INSTALL_ARGS[@]}"

%{ if is_seed ~}
###############################################################################
# 2a. Seed: cluster-init.sh
#
# --role must contain "server" or be "mixed" (cluster-init.sh validates).
# --tls-bundle-out is pinned to /tmp so we can find it after sudo (the
# script's default uses $PWD, which under cloud-init is unspecified).
# --ingress-advertise-host is the public hostname SDK-returned URLs use.
###############################################################################
GOSSIP_KEY="$(openssl rand -base64 32)"

curl_download '${cluster_init_script_url}' -o /tmp/cluster-init.sh
chmod +x /tmp/cluster-init.sh
# --node-id pins the gossip/Raft identity to the Terraform node name instead
# of the EC2 hostname. The signing rendezvous below needs an id BOTH sides can
# agree on without trusting the joiner, and only Terraform knows one; it also
# makes /v1/cluster/members readable (node names, not ip-10-42-1-43).
sudo /tmp/cluster-init.sh \
  --role '${role}' \
  --node-id '${node_name}' \
  --ingress-advertise-host '${domain}' \
  --gossip-key "$GOSSIP_KEY" \
  --tls-bundle-out /tmp/aerolvm-tls-bundle.tar.gz \
  --cred-bundle-out /tmp/aerolvm-cred-bundle.tar.gz

# Publish artifacts joiners need. Bucket is private + SSE-encrypted.
printf '%s' "$GOSSIP_KEY" > /tmp/gossip-key.txt
aws --region '${aws_region}' s3 cp /tmp/gossip-key.txt \
    "s3://${bundle_bucket}/gossip-key.txt" \
    --sse AES256
aws --region '${aws_region}' s3 cp /tmp/aerolvm-tls-bundle.tar.gz \
    "s3://${bundle_bucket}/aerolvm-tls-bundle.tar.gz" \
    --sse AES256
# The credential encryption key ships SEPARATELY from the ca.crt trust bundle
# (cluster-init.sh keeps them apart to limit blast radius if ca.crt is copied
# more widely). cluster-join.sh REQUIRES --cred-bundle and aborts without it,
# so a joiner cannot bootstrap until this object exists.
aws --region '${aws_region}' s3 cp /tmp/aerolvm-cred-bundle.tar.gz \
    "s3://${bundle_bucket}/aerolvm-cred-bundle.tar.gz" \
    --sse AES256

echo "[bootstrap] seed published bundle to s3://${bundle_bucket}/"

###############################################################################
# 2a-bis. Seed: CSR signing loop.
#
# ca.key never leaves this host, so joiners cannot self-sign. Each joiner
# uploads its CSR to csr/<caller-identity>/node.csr and waits for
# crt/<caller-identity>.crt to appear.
#
# SECURITY: the node id is taken from nodes/<caller-identity> — an object only
# Terraform writes — and NEVER from the uploaded path or the CSR itself.
# cluster-sign-node.sh stamps DNS:node:<id> from its --node-id flag without
# inspecting the CSR's subject, so an id chosen by the uploader would let any
# joiner mint a cert for another node and impersonate it over cluster mTLS.
# IAM confines each joiner to csr/$${aws:userid}/, which AWS assigns.
#
# Runs in the background so the seed's own bootstrap finishes; bounded by
# seed_wait_max_seconds so a stuck loop cannot hold the box forever. Signing is
# serial: cluster-sign-node.sh uses `openssl -CAcreateserial` and removes
# ca.srl afterwards, which two concurrent signers would race.
###############################################################################
sudo tee /usr/local/bin/aerolvm-csr-signer.sh >/dev/null <<'SIGNER'
#!/usr/bin/env bash
set -uo pipefail
BUCKET="$1"; REGION="$2"; DEADLINE_TS="$3"
log() { echo "[csr-signer] $*"; }
while [ "$(date +%s)" -lt "$DEADLINE_TS" ]; do
  # List the csr/ prefix one directory deep; each entry is one caller identity.
  for ident in $(aws --region "$REGION" s3 ls "s3://$BUCKET/csr/" 2>/dev/null                  | awk '$1 == "PRE" { sub(/\/$/, "", $2); print $2 }'); do
    if aws --region "$REGION" s3api head-object --bucket "$BUCKET"          --key "crt/$ident.crt" >/dev/null 2>&1; then
      continue  # already signed; idempotent across loop passes and restarts
    fi
    tmp="$(mktemp -d)"
    if ! aws --region "$REGION" s3 cp "s3://$BUCKET/csr/$ident/node.csr"          "$tmp/node.csr" >/dev/null 2>&1; then
      rm -rf "$tmp"; continue
    fi
    # Authoritative id for this uploader. Absent => Terraform has not recorded
    # this instance (or something wrote an unexpected prefix): refuse to sign
    # rather than guess, and say so loudly.
    if ! aws --region "$REGION" s3 cp "s3://$BUCKET/nodes/$ident"          "$tmp/node-id" >/dev/null 2>&1; then
      log "no nodes/$ident mapping; refusing to sign (id must not come from the uploader)"
      rm -rf "$tmp"; continue
    fi
    node_id="$(tr -d '[:space:]' < "$tmp/node-id")"
    if [ -z "$node_id" ]; then
      log "empty node id for $ident; refusing to sign"
      rm -rf "$tmp"; continue
    fi
    if /usr/local/bin/cluster-sign-node.sh --csr "$tmp/node.csr"          --node-id "$node_id" --out "$tmp/node.crt" >/dev/null 2>&1; then
      if aws --region "$REGION" s3 cp "$tmp/node.crt"            "s3://$BUCKET/crt/$ident.crt" --sse AES256 >/dev/null 2>&1; then
        log "signed node:$node_id for $ident"
      else
        log "upload of crt/$ident.crt failed; will retry"
      fi
    else
      log "signing failed for $ident (node:$node_id)"
    fi
    rm -rf "$tmp"
  done
  sleep 5
done
log "deadline reached; exiting"
SIGNER
sudo chmod 0755 /usr/local/bin/aerolvm-csr-signer.sh
curl_download '${cluster_sign_node_script_url}' -o /tmp/cluster-sign-node.sh
sudo install -m 0755 /tmp/cluster-sign-node.sh /usr/local/bin/cluster-sign-node.sh

sudo systemd-run --unit=aerolvm-csr-signer --description='AerolVM CSR signing rendezvous' \
  /usr/local/bin/aerolvm-csr-signer.sh '${bundle_bucket}' '${aws_region}' \
  "$(( $(date +%s) + ${seed_wait_max_seconds} ))" \
  || echo "[bootstrap] WARNING: could not start the CSR signer; joiners will not get certs" >&2
echo "[bootstrap] seed CSR signer started (deadline ${seed_wait_max_seconds}s)"
%{ else ~}
###############################################################################
# 2b. Joiner: cluster-join.sh
#
# Polls S3 for the seed's two artifacts (gossip key + TLS bundle), then runs
# cluster-join.sh with --peers <seed-private-ip>:7001 (the seed's gossip
# advertise address, derived by cluster-init from its primary IP).
###############################################################################
deadline=$(( $(date +%s) + ${seed_wait_max_seconds} ))
while :; do
  if aws --region '${aws_region}' s3api head-object \
       --bucket '${bundle_bucket}' --key 'gossip-key.txt' >/dev/null 2>&1 \
     && aws --region '${aws_region}' s3api head-object \
       --bucket '${bundle_bucket}' --key 'aerolvm-tls-bundle.tar.gz' >/dev/null 2>&1 \
     && aws --region '${aws_region}' s3api head-object \
       --bucket '${bundle_bucket}' --key 'aerolvm-cred-bundle.tar.gz' >/dev/null 2>&1; then
    break
  fi
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "[bootstrap] timed out waiting for seed artifacts" >&2
    exit 1
  fi
  echo "[bootstrap] waiting for seed artifacts in s3://${bundle_bucket}/..."
  sleep 10
done

aws --region '${aws_region}' s3 cp \
    "s3://${bundle_bucket}/gossip-key.txt" /tmp/gossip-key.txt
aws --region '${aws_region}' s3 cp \
    "s3://${bundle_bucket}/aerolvm-tls-bundle.tar.gz" /tmp/aerolvm-tls-bundle.tar.gz
# cluster-join.sh REQUIRES --cred-bundle: the credential encryption key ships
# separately from the ca.crt trust tarball so copying ca.crt around does not
# also hand out the key.
aws --region '${aws_region}' s3 cp \
    "s3://${bundle_bucket}/aerolvm-cred-bundle.tar.gz" /tmp/aerolvm-cred-bundle.tar.gz
GOSSIP_KEY="$(cat /tmp/gossip-key.txt)"

curl_download '${cluster_join_script_url}' -o /tmp/cluster-join.sh
chmod +x /tmp/cluster-join.sh

###############################################################################
# 2b-bis. CSR rendezvous.
#
# ca.key never leaves the seed, so this is a two-pass join:
#   pass 1  mints node.key + node.csr locally and EXITS 2 on purpose, before
#           restarting the daemon (cluster-join.sh's "CSR ready" path).
#   ...     upload the CSR, wait for the seed's signer to publish the cert.
#   pass 2  installs --signed-cert, writes cluster.env, restarts sandboxd.
#
# The upload prefix is this instance's own IAM caller identity, which it cannot
# choose: IAM only grants PutObject under csr/$${aws:userid}/. The seed maps
# that identity to a node id through an object only Terraform writes, so a
# joiner cannot ask for a cert bound to another node's identity.
###############################################################################
JOIN_ARGS=(
  --role '${role}'
  --node-id '${node_name}'
  --ingress-advertise-host '${domain}'
  --gossip-key "$GOSSIP_KEY"
  --peers '${seed_private_ip}:7001'
  --tls-bundle /tmp/aerolvm-tls-bundle.tar.gz
  --cred-bundle /tmp/aerolvm-cred-bundle.tar.gz
)

# Pass 1. Exit 2 is the documented "CSR ready, stopping before daemon restart"
# signal, so it is the SUCCESS case here; anything else is fatal. Exit 0 means
# a node.crt was already present (a re-run), so there is nothing to sign.
set +e
sudo /tmp/cluster-join.sh "$${JOIN_ARGS[@]}"
join_rc=$?
set -e
if [ "$join_rc" -eq 0 ]; then
  echo "[bootstrap] joiner already held a signed cert; join complete"
elif [ "$join_rc" -ne 2 ]; then
  echo "[bootstrap] cluster-join pass 1 failed with $join_rc" >&2
  exit "$join_rc"
else
  # Terraform records the authoritative identity under this exact key, using
  # the joiner role's unique id plus the instance id. Deriving it here (rather
  # than calling sts) keeps the joiner and the seed reading the same string
  # even if the instance profile is ever attached to a different role.
  INSTANCE_ID="$(cloud-init query instance_id 2>/dev/null \
    || curl -fsS -H "X-aws-ec2-metadata-token: $(curl -fsS -X PUT \
         -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
         http://169.254.169.254/latest/api/token)" \
       http://169.254.169.254/latest/meta-data/instance-id)"
  if [ -z "$INSTANCE_ID" ]; then
    echo "[bootstrap] could not determine instance id for the CSR rendezvous" >&2
    exit 1
  fi
  # The upload path must be EXACTLY what IAM evaluates as $${aws:userid}, or
  # the PutObject is denied; and it must equal the key Terraform wrote the
  # identity mapping under, or the seed refuses to sign. Both sides derive it
  # as "<joiner-role-unique-id>:<instance-id>", which relies on EC2 using the
  # instance id as the role session name. That is the documented behaviour, but
  # it is an assumption, so verify it rather than discover a mismatch as an
  # opaque 403 or a cert that never arrives.
  EXPECTED_IDENT="${joiner_role_unique_id}:$${INSTANCE_ID}"
  CALLER_IDENT="$(aws sts get-caller-identity --query UserId --output text 2>/dev/null || true)"
  if [ -z "$${CALLER_IDENT}" ]; then
    CALLER_IDENT="$${EXPECTED_IDENT}"
  elif [ "$${CALLER_IDENT}" != "$${EXPECTED_IDENT}" ]; then
    echo "[bootstrap] IAM caller identity is '$${CALLER_IDENT}' but the seed's nodes/ mapping is keyed on '$${EXPECTED_IDENT}'" >&2
    echo "[bootstrap] refusing to continue: the CSR would be rejected or signed under the wrong identity" >&2
    exit 1
  fi
  echo "[bootstrap] uploading CSR as $${CALLER_IDENT}"

  if [ ! -f /etc/sandboxd/tls/node.csr ]; then
    echo "[bootstrap] cluster-join reported CSR ready but /etc/sandboxd/tls/node.csr is missing" >&2
    exit 1
  fi
  sudo aws --region '${aws_region}' s3 cp /etc/sandboxd/tls/node.csr \
      "s3://${bundle_bucket}/csr/$${CALLER_IDENT}/node.csr" --sse AES256

  # Wait for the seed's signer. Bounded by the same budget as the artifact
  # wait: if the signer died the joiner must fail loudly rather than hang for
  # the life of the box.
  crt_deadline=$(( $(date +%s) + ${seed_wait_max_seconds} ))
  while :; do
    if aws --region '${aws_region}' s3api head-object \
         --bucket '${bundle_bucket}' --key "crt/$${CALLER_IDENT}.crt" >/dev/null 2>&1; then
      break
    fi
    if [ "$(date +%s)" -ge "$crt_deadline" ]; then
      echo "[bootstrap] timed out waiting for crt/$${CALLER_IDENT}.crt — is the seed's aerolvm-csr-signer running?" >&2
      exit 1
    fi
    echo "[bootstrap] waiting for the seed to sign $${CALLER_IDENT}..."
    sleep 5
  done
  aws --region '${aws_region}' s3 cp \
      "s3://${bundle_bucket}/crt/$${CALLER_IDENT}.crt" /tmp/node.crt

  # Pass 2 installs the cert, writes cluster.env and restarts the daemon.
  sudo /tmp/cluster-join.sh "$${JOIN_ARGS[@]}" --signed-cert /tmp/node.crt
  echo "[bootstrap] joiner installed a seed-signed cert and joined"
fi
%{ endif ~}

###############################################################################
# 2c. Immediate cluster-mode diagnostics.
#
# The integration harness also collects these over SSH after failures, but this
# block lands in /var/log/aerolvm-bootstrap.log during cloud-init itself. That
# matters when sandboxd fails before the later collector can reach every node,
# or when Terraform is using released cluster-init/join scripts that do not yet
# include the same diagnostics.
###############################################################################
echo "[bootstrap] post cluster-mode diagnostics"
sudo systemctl is-active sandboxd || true
sudo systemctl show sandboxd \
  -p ActiveState -p SubState -p MainPID -p NRestarts -p ExecMainStatus \
  --no-pager || true
echo "[bootstrap] listeners on cluster ports"
sudo ss -ltnup 2>/dev/null | grep -E ':(7000|7001|7002|21212)\b' || echo "(nothing listening on cluster ports yet)"
echo "[bootstrap] local /health"
curl -sS --max-time 5 http://127.0.0.1:21212/health || true
echo
set +x
BOOTSTRAP_PAT="$(sudo awk -F= '$1 == "SB_PAT_TOKEN" { print substr($0, length($1) + 2) }' /etc/sandboxd/sandboxd.env 2>/dev/null || true)"
if [ -n "$${BOOTSTRAP_PAT}" ]; then
  echo "[bootstrap] local /v1/cluster/members"
  curl -sS --max-time 5 -H "Authorization: Bearer $${BOOTSTRAP_PAT}" \
    http://127.0.0.1:21212/v1/cluster/members || true
  echo
  echo "[bootstrap] local /v1/cluster/leader"
  curl -sS --max-time 5 -H "Authorization: Bearer $${BOOTSTRAP_PAT}" \
    http://127.0.0.1:21212/v1/cluster/leader || true
  echo
fi
unset BOOTSTRAP_PAT
set -x

%{ if with_firecracker ~}
###############################################################################
# 2d. Firecracker host prerequisites
#
# install.sh does not yet know how to provision Firecracker hosts, so the
# Terraform bootstrap handles the host-side prerequisites for nodes that opt
# in. URLs are optional: when omitted and auto_install_artifacts is true,
# bootstrap pulls the arch-matched upstream release + spec.ccfc.min kernel.
###############################################################################

# KVM precondition. Firecracker is a KVM-only VMM — without /dev/kvm there
# is nothing to install onto. Fail user-data with a paste-able remediation
# instead of letting sandboxd hit it at first CreateSandbox(runtime=
# firecracker). The check fires from user-data so the EC2 instance still
# launches, but cloud-init reports failed and the node never joins the
# cluster — exactly the signal an operator needs to fix the instance type.
if [ ! -e /dev/kvm ]; then
  cat >&2 <<EOF
[bootstrap] /dev/kvm is missing on this host (uname -m: $(uname -m)).
Firecracker is KVM-only and CANNOT run on this instance.

Most likely cause on AWS: the instance type does not pass KVM through.
  * Use a bare-metal type: *.metal (c5n.metal, m5zn.metal, c7g.metal,
    i3.metal, m5.metal, c5.metal, etc.). Standard t3/m5/c5/c6i/m6i/r5
    instances are themselves Nitro guests and do not expose /dev/kvm.
  * GCP: enable nested virtualization on the image (N2/N1 only,
    --enable-nested-virtualization). Azure: Dv3/Ev3+ with nested virt.
  * Bare metal: enable Intel VT-x / AMD-V in BIOS, then
    sudo modprobe kvm_intel (or kvm_amd).

To proceed WITHOUT Firecracker, in your terraform.tfvars set:
  default_with_firecracker = false
and remove the per-node override (with_firecracker = true) from any
node entry in the nodes list. Then: terraform apply.

To enable Firecracker only on capable nodes, leave
default_with_firecracker = false and set with_firecracker = true only on
node entries whose instance_type is a bare-metal SKU.
EOF
  exit 1
fi

apt-get install -y skopeo umoci e2fsprogs iproute2

install -d -m 0755 \
  "$(dirname '${firecracker_binary_path}')" \
  "$(dirname '${firecracker_jailer_path}')" \
  "$(dirname '${firecracker_kernel_path}')" \
  '${firecracker_run_dir}' \
  '${firecracker_templates_dir}'

%{ if firecracker_use_jailer ~}
install -d -m 0755 '${firecracker_jailer_chroot_base}'
%{ endif ~}

# When operator *_url fields are empty and auto_install is enabled, pull the
# arch-matched upstream release (pins mirror Ansible configure-ops.yml).
if [ '${firecracker_auto_install}' = 'true' ] && [ -z '${firecracker_binary_url}' ]; then
  FC_VERSION='${firecracker_version}'
  FC_ARCH='${firecracker_upstream_arch}'
  FC_RELEASE_BASE="https://github.com/firecracker-microvm/firecracker/releases/download/$${FC_VERSION}"
  FC_TARBALL="firecracker-$${FC_VERSION}-$${FC_ARCH}.tgz"
  FC_WORKDIR="$(mktemp -d)"
  trap 'rm -rf "$${FC_WORKDIR}"' EXIT
  curl_download "$${FC_RELEASE_BASE}/$${FC_TARBALL}" -o "$${FC_WORKDIR}/$${FC_TARBALL}"
  curl_download "$${FC_RELEASE_BASE}/$${FC_TARBALL}.sha256.txt" -o "$${FC_WORKDIR}/$${FC_TARBALL}.sha256.txt"
  (cd "$${FC_WORKDIR}" && sha256sum -c "$${FC_TARBALL}.sha256.txt")
  tar -xzf "$${FC_WORKDIR}/$${FC_TARBALL}" -C "$${FC_WORKDIR}"
  install -m 0755 \
    "$${FC_WORKDIR}/release-$${FC_VERSION}-$${FC_ARCH}/firecracker-$${FC_VERSION}-$${FC_ARCH}" \
    '${firecracker_binary_path}'
  if [ '${firecracker_use_jailer}' = 'true' ]; then
    install -m 0755 \
      "$${FC_WORKDIR}/release-$${FC_VERSION}-$${FC_ARCH}/jailer-$${FC_VERSION}-$${FC_ARCH}" \
      '${firecracker_jailer_path}'
  fi
  rm -rf "$${FC_WORKDIR}"
  trap - EXIT
fi

if [ '${firecracker_auto_install}' = 'true' ] && [ -z '${firecracker_kernel_url}' ]; then
  FC_ARCH='${firecracker_upstream_arch}'
  KERNEL_CI='${firecracker_kernel_ci_version}'
  KERNEL_VER='${firecracker_kernel_version}'
  KERNEL_BASE="https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/$${KERNEL_CI}/$${FC_ARCH}"
  curl_download "$${KERNEL_BASE}/vmlinux-$${KERNEL_VER}" -o /tmp/vmlinux
  install -m 0644 /tmp/vmlinux '${firecracker_kernel_path}'
  curl_download "$${KERNEL_BASE}/vmlinux-$${KERNEL_VER}.config" -o /tmp/vmlinux.config
  install -m 0644 /tmp/vmlinux.config '${firecracker_kernel_path}.config'
fi

if [ -n '${firecracker_binary_url}' ]; then
  curl_download '${firecracker_binary_url}' -o /tmp/firecracker.bin
  install -m 0755 /tmp/firecracker.bin '${firecracker_binary_path}'
fi

if [ -n '${firecracker_jailer_url}' ]; then
  curl_download '${firecracker_jailer_url}' -o /tmp/jailer.bin
  install -m 0755 /tmp/jailer.bin '${firecracker_jailer_path}'
fi

if [ -n '${firecracker_kernel_url}' ]; then
  curl_download '${firecracker_kernel_url}' -o /tmp/vmlinux
  install -m 0644 /tmp/vmlinux '${firecracker_kernel_path}'
fi

if [ -n '${firecracker_kernel_config_url}' ]; then
  curl_download '${firecracker_kernel_config_url}' -o /tmp/vmlinux.config
  install -m 0644 /tmp/vmlinux.config '${firecracker_kernel_path}.config'
elif [ -n '${firecracker_kernel_url}' ]; then
  curl_download '${firecracker_kernel_url}.config' -o /tmp/vmlinux.config
  install -m 0644 /tmp/vmlinux.config '${firecracker_kernel_path}.config'
fi

if [ ! -x '${firecracker_binary_path}' ]; then
  echo "[bootstrap] firecracker binary missing or not executable at ${firecracker_binary_path}" >&2
  exit 1
fi
if [ ! -f '${firecracker_kernel_path}' ]; then
  echo "[bootstrap] firecracker kernel missing at ${firecracker_kernel_path}" >&2
  exit 1
fi
if [ ! -f '${firecracker_kernel_path}.config' ]; then
  echo "[bootstrap] firecracker kernel config missing at ${firecracker_kernel_path}.config" >&2
  exit 1
fi
if ! grep -qx 'CONFIG_VMGENID=y' '${firecracker_kernel_path}.config'; then
  echo "[bootstrap] firecracker kernel config at ${firecracker_kernel_path}.config does not enable CONFIG_VMGENID=y" >&2
  exit 1
fi
if [ '${firecracker_use_jailer}' = 'true' ] && [ ! -x '${firecracker_jailer_path}' ]; then
  echo "[bootstrap] jailer binary missing or not executable at ${firecracker_jailer_path}" >&2
  exit 1
fi
%{ endif ~}

###############################################################################
# 3. Operational hardening env
#
# cluster-init/join writes /etc/sandboxd/cluster.env and the systemd drop-in
# already includes it. Append the observability and image-pull storm controls
# Terraform owns, then restart so the just-bootstrapped daemon picks them up.
###############################################################################
cat > /tmp/aerolvm-ops.env <<'EOF'

# Managed by Terraform bootstrap: observability and operational hardening.
SB_OTEL_METRICS_ENABLED=${otel_metrics_enabled}
SB_OTEL_METRICS_ENDPOINT=${otel_metrics_endpoint}
SB_OTEL_METRICS_INTERVAL=${otel_metrics_interval}
SB_OTEL_TRACES_ENABLED=${otel_traces_enabled}
SB_OTEL_TRACES_ENDPOINT=${otel_traces_endpoint}
SB_OTEL_TRACES_SAMPLE_RATIO=${otel_traces_sample_ratio}
OTEL_SERVICE_NAME=${otel_service_name}
SB_IMAGE_PULL_MAX_CONCURRENT=${image_pull_max_concurrent}
SB_IMAGE_PULL_FAILURE_BACKOFF=${image_pull_failure_backoff}
SB_IMAGE_GC_WHITELIST=${image_gc_whitelist}
SB_IMAGE_BUILD_GC_ENABLED=${image_build_gc_enabled}
SB_IMAGE_BUILD_GC_INTERVAL=${image_build_gc_interval}
SB_IMAGE_BUILD_GC_TTL=${image_build_gc_ttl}
SB_ENABLE_CUSTOM_DOMAINS=${enable_custom_domains}
# More than 10 ingress-capable nodes need a shard-aware router in front of the
# tier (GET /v1/cluster/ingress-route/{id}); the daemon fails closed without
# this declaration. See setup/runbooks/cluster-ingress-topology.md.
SB_CLUSTER_SHARD_AWARE_INGRESS=${shard_aware_ingress}
SB_CUSTOM_DOMAIN_VERIFY_PREFIX=${custom_domain_txt_prefix}
SB_CUSTOM_DOMAIN_VERIFY_VALUE_PREFIX=${custom_domain_txt_value_prefix}
SB_PLATFORM_VOLUMES_ENABLED=${platform_volumes_cfg.enabled}
SB_PLATFORM_VOLUMES_BACKEND=${platform_volumes_cfg.backend}
SB_PLATFORM_VOLUMES_MAX_PER_TENANT=${platform_volumes_cfg.max_per_tenant}
SB_PLATFORM_VOLUMES_RECLAIM_INTERVAL=${platform_volumes_cfg.reclaim_interval}
SB_PLATFORM_VOLUMES_RECLAIM_MOUNT_ROOT=${platform_volumes_cfg.reclaim_mount_root}
SB_PLATFORM_VOLUMES_RECLAIM_CONCURRENCY=${platform_volumes_cfg.reclaim_concurrency}
SB_PLATFORM_VOLUMES_S3_BUCKET=${platform_volumes_cfg.s3_bucket}
SB_PLATFORM_VOLUMES_S3_PREFIX=${platform_volumes_cfg.s3_prefix}
SB_PLATFORM_VOLUMES_S3_REGION=${platform_volumes_cfg.s3_region}
SB_PLATFORM_VOLUMES_S3_ENDPOINT=${platform_volumes_cfg.s3_endpoint}
SB_PLATFORM_VOLUMES_S3_ACCESS_KEY_ID=${platform_volumes_cfg.s3_access_key_id}
SB_PLATFORM_VOLUMES_S3_SECRET_ACCESS_KEY=${platform_volumes_cfg.s3_secret_access_key}
SB_PLATFORM_VOLUMES_NFS_SERVER=${platform_volumes_cfg.nfs_server}
SB_PLATFORM_VOLUMES_NFS_EXPORT=${platform_volumes_cfg.nfs_export}
SB_PLATFORM_VOLUMES_NFS_OPTIONS=${platform_volumes_cfg.nfs_options}
EOF

%{ if with_firecracker ~}
cat >> /tmp/aerolvm-ops.env <<'EOF'

# Managed by Terraform bootstrap: Firecracker runtime host wiring.
SB_ENABLE_FIRECRACKER=true
SB_FIRECRACKER_BINARY=${firecracker_binary_path}
SB_JAILER_BINARY=${firecracker_jailer_path}
SB_FIRECRACKER_KERNEL=${firecracker_kernel_path}
SB_FIRECRACKER_RUN_DIR=${firecracker_run_dir}
SB_FIRECRACKER_TEMPLATES_DIR=${firecracker_templates_dir}
SB_FIRECRACKER_USE_JAILER=${firecracker_use_jailer}
SB_JAILER_CHROOT_BASE=${firecracker_jailer_chroot_base}
SB_JAILER_UID=${firecracker_jailer_uid}
SB_JAILER_GID=${firecracker_jailer_gid}
SB_FIRECRACKER_TAP_BASE_CIDR=${firecracker_tap_base_cidr}
SB_FIRECRACKER_TAP_POOL_SIZE=${firecracker_tap_pool_size}
SB_FIRECRACKER_SKOPEO_BIN=${firecracker_skopeo_bin}
SB_FIRECRACKER_UMOCI_BIN=${firecracker_umoci_bin}
SB_FIRECRACKER_MKFS_BIN=${firecracker_mkfs_bin}
SB_FIRECRACKER_IP_BINARY=${firecracker_ip_binary}
SB_FIRECRACKER_TEMPLATE_GC_ENABLED=${firecracker_template_gc_enabled}
SB_FIRECRACKER_TEMPLATE_GC_INTERVAL=${firecracker_template_gc_interval}
SB_FIRECRACKER_TEMPLATE_GC_TTL=${firecracker_template_gc_ttl}
SB_FIRECRACKER_SNAPSHOT_ENABLED=${firecracker_snapshot_enabled}
SB_FIRECRACKER_TEMPLATE_BUILD_TIMEOUT=${firecracker_template_build_timeout}
SB_FIRECRACKER_TEMPLATE_ROTATION_INTERVAL=${firecracker_template_rotation_interval}
SB_FIRECRACKER_TEMPLATE_MAX_AGE=${firecracker_template_max_age}
SB_FIRECRACKER_TEMPLATE_MEMORY_MB=${firecracker_template_memory_mb}
SB_FIRECRACKER_TEMPLATE_VCPU=${firecracker_template_vcpu}
SB_FIRECRACKER_SNAPSHOT_VERIFY_ON_LOAD=${firecracker_snapshot_verify_on_load}
SB_FIRECRACKER_OVERLAY_ENABLED=${firecracker_overlay_enabled}
SB_FIRECRACKER_OVERLAY_MKFS=${firecracker_overlay_mkfs}
SB_FIRECRACKER_SNAPSHOT_POST_RESUME_TIMEOUT=${firecracker_snapshot_post_resume_timeout}
SB_FIRECRACKER_VMM_POOL_ENABLED=${firecracker_vmm_pool_enabled}
SB_FIRECRACKER_VMM_POOL_DEPTH_DEFAULT=${firecracker_vmm_pool_depth_default}
SB_FIRECRACKER_VMM_POOL_GC_INTERVAL=${firecracker_vmm_pool_gc_interval}
SB_FIRECRACKER_VMM_POOL_GC_TTL=${firecracker_vmm_pool_gc_ttl}
SB_FIRECRACKER_VMM_POOL_REFILL_INTERVAL=${firecracker_vmm_pool_refill_interval}
SB_FIRECRACKER_RSS_SAMPLER_INTERVAL=${firecracker_rss_sampler_interval}
SB_FIRECRACKER_RSS_WATERMARK_RATIO=${firecracker_rss_watermark_ratio}
EOF
%{ endif ~}

%{ if aocr_enabled ~}
###############################################################################
# 3b. AOCR (Phase 4 F17-F21) — authenticated mirror + auto-import.
#
# Wrap key and cluster PAT are file-sourced so they never appear in
# `systemctl show sandboxd` env dumps or process listings. Install under
# /etc/sandboxd/secrets/ (matches the paths the sandboxd config defaults expect
# and that the Ansible configure-ops playbook uses). The cluster PAT remains
# 0600; the upstream wrap key is read-only (0400) because the loader rejects
# writable key files so accidental rotation/editing cannot happen in place.
###############################################################################
sudo install -d -m 0700 -o root -g root /etc/sandboxd/secrets

%{ if aocr_upstream_wrap_key != "" ~}
# Base64 AES-GCM wrap key. Must match an entry in AOCR's
# UPSTREAM_AUTH_WRAP_KEYS env var or wrapping will silently fail and
# private upstream pulls will 401.
umask 077
cat > /etc/sandboxd/secrets/upstream-wrap.key <<'EOF'
${aocr_upstream_wrap_key}
EOF
sudo chown root:root /etc/sandboxd/secrets/upstream-wrap.key
sudo chmod 0400 /etc/sandboxd/secrets/upstream-wrap.key
%{ endif ~}

%{ if aocr_cluster_pat != "" ~}
# Cluster PAT used as Bearer token on POST /v1/internal/imports. Sandboxd
# reads it via SB_AUTO_IMPORT_CLUSTER_PAT_PATH at request time; never put it
# in an env var (it would land in logs and `ps`/`systemctl show` output).
umask 077
cat > /etc/sandboxd/secrets/cluster-pat <<'EOF'
${aocr_cluster_pat}
EOF
sudo chown root:root /etc/sandboxd/secrets/cluster-pat
sudo chmod 0600 /etc/sandboxd/secrets/cluster-pat
%{ endif ~}

%{ if ssh_host_key_pem != "" ~}
# Shared SSH host key (UC-22). Distributing the SAME private host key to every
# ingress-bearing node gives clients a stable host identity: as the leased SSH
# domain load-balances them across nodes they no longer see
# "REMOTE HOST IDENTIFICATION HAS CHANGED" warnings. Omit the var to keep
# per-node keys (sandboxd generates one on first boot). The daemon reads this
# path via SB_SSH_HOST_KEY_PATH.
umask 077
sudo install -d -m 0700 -o root -g root /var/lib/sandboxd
cat > /var/lib/sandboxd/ssh_host_ed25519_key <<'EOF'
${ssh_host_key_pem}
EOF
sudo chown root:root /var/lib/sandboxd/ssh_host_ed25519_key
sudo chmod 0600 /var/lib/sandboxd/ssh_host_ed25519_key
%{ endif ~}

cat >> /tmp/aerolvm-ops.env <<'EOF'

# Managed by Terraform bootstrap: AOCR mirror + auto-import (Phase 4).
SB_MIRROR_HOST=${aocr_mirror_host}
SB_MIRROR_PUSH_HOST=${aocr_mirror_push_host}
SB_MIRROR_UPSTREAMS=${aocr_mirror_upstreams}
SB_UPSTREAM_WRAP_KEY_PATH=%{ if aocr_upstream_wrap_key != "" ~}/etc/sandboxd/secrets/upstream-wrap.key%{ endif }
SB_AUTO_IMPORT_ENABLED=${aocr_auto_import_enabled}
SB_AUTO_IMPORT_HOOKS_URL=${aocr_hooks_url}
SB_AUTO_IMPORT_CLUSTER_ID=${aocr_cluster_id}
SB_AUTO_IMPORT_CLUSTER_PAT_PATH=%{ if aocr_cluster_pat != "" ~}/etc/sandboxd/secrets/cluster-pat%{ endif }
SB_AUTO_IMPORT_RETENTION_SUFFIX=${aocr_retention_suffix}
SB_AUTO_IMPORT_REQUEST_TIMEOUT=${aocr_request_timeout}
SB_AUTO_IMPORT_RECONCILE_INTERVAL=${aocr_reconcile_interval}
SB_AUTO_IMPORT_MAX_IN_FLIGHT=${aocr_max_in_flight}
# Snapshot distribution: push sandbox snapshots + firecracker templates to AOCR
# at <push_host>/cluster/<cluster_id>/snapshots/<name> so any node can pull a
# sandbox created from a peer's snapshot. Reuses the cluster PAT (above) as the
# registry password.
SB_SNAPSHOT_PUSH_ENABLED=${aocr_snapshot_push_enabled}
SB_SNAPSHOT_PUSH_RECONCILE_INTERVAL=${aocr_snapshot_push_reconcile_interval}
SB_SNAPSHOT_PUSH_MAX_IN_FLIGHT=${aocr_snapshot_push_max_in_flight}
SB_SNAPSHOT_PUSH_TAG_SUFFIX=${aocr_snapshot_push_tag_suffix}
EOF
%{ endif ~}

%{ if fleet_enabled ~}
cat >> /tmp/aerolvm-ops.env <<'EOF'

# Managed by Terraform bootstrap: fleet control plane (optional).
# The token is a Bearer secret; cluster.env is root-owned 0600. Every other
# tunable is fetched from the managed contract API at runtime, so only these
# four land here. (A file-based token delivery like cluster-pat — read via an
# SB_FLEET_TOKEN_PATH — is a possible hardening follow-up.)
SB_FLEET_ENABLED=${fleet_enabled}
SB_FLEET_ENDPOINT=${fleet_endpoint}
SB_FLEET_TOKEN=${fleet_token}
SB_FLEET_CONTRACT_REFRESH=${fleet_contract_refresh}
EOF
%{ endif ~}

# WASM runtime + module distribution. Written UNCONDITIONALLY: wasm enablement
# is independent of the fleet control plane, so it must not be nested in the
# fleet_enabled block above. (It once was, which silently left SB_ENABLE_WASM
# unset on every fleet-disabled deploy — e.g. the integration harness, which
# always disables fleet — so the daemon booted with EnableWasm=false and every
# wasm create failed placement with ErrNoPlacementTarget.) SB_WASM_STANDARD_MODULES
# is the reserved-keyword contract (alias=alias.wasm,...); stage the .wasm files
# with Ansible playbooks/stage-wasm-modules.yml so every node has identical bytes.
cat >> /tmp/aerolvm-ops.env <<'EOF'

# Managed by Terraform bootstrap: WASM runtime + module distribution.
SB_ENABLE_WASM=${wasm_cfg.enabled}
SB_WASM_MODULES_DIR=${wasm_cfg.modules_dir}
SB_WASM_CACHE_DIR=${wasm_cfg.cache_dir}
SB_WASM_POOL_ENABLED=${wasm_cfg.pool_enabled}
SB_WASM_POOL_DEPTH_DEFAULT=${wasm_cfg.pool_depth_default}
SB_WASM_REGISTRY_ALLOWLIST=${wasm_cfg.registry_allowlist}
SB_WASM_PULL_TIMEOUT=${wasm_cfg.pull_timeout}
SB_WASM_REGISTRY_PUSH_HOST=${wasm_cfg.push_host}
SB_WASM_REGISTRY_USERNAME=${wasm_cfg.registry_username}
SB_WASM_REGISTRY_PAT_PATH=${wasm_cfg.registry_pat_path}
SB_WASM_STANDARD_MODULES=${wasm_cfg.standard_modules}

# Managed by Terraform bootstrap: Docker warm container pool (park + adopt).
SB_DOCKER_POOL_ENABLED=${docker_pool_cfg.enabled}
SB_DOCKER_POOL_DEPTH=${docker_pool_cfg.depth}
SB_DOCKER_POOL_IMAGES=${docker_pool_cfg.images}
SB_DOCKER_POOL_MAX_IMAGES=${docker_pool_cfg.max_images}
SB_DOCKER_POOL_IDLE_TTL=${docker_pool_cfg.idle_ttl}
SB_DOCKER_POOL_REFILL_INTERVAL=${docker_pool_cfg.refill_interval}

# Managed by Terraform bootstrap: pause-netns pool (prepaid network
# namespaces for docker cold creates). Without these lines the
# docker-netns-pool capability silently no-ops: run.sh writes
# docker.netns_pool.enabled into cluster.yml but only this template
# turns cluster.yml into sandboxd env on Terraform-provisioned nodes.
SB_DOCKER_NETNS_POOL_ENABLED=${docker_netns_pool_cfg.enabled}
SB_DOCKER_NETNS_POOL_DEPTH=${docker_netns_pool_cfg.depth}
SB_DOCKER_NETNS_POOL_PAUSE_IMAGE=${docker_netns_pool_cfg.pause_image}
SB_DOCKER_NETNS_POOL_REFILL_INTERVAL=${docker_netns_pool_cfg.refill_interval}

# Managed by Terraform bootstrap: container engine (plans/containerd-engine.md).
# Default docker. containerd requires CNI plugin binaries under cni_plugin_dir
# (installed below when the engine is containerd).
SB_CONTAINER_ENGINE=${container_engine}
SB_CONTAINERD_SOCKET=${containerd_cfg.socket}
SB_CONTAINERD_NAMESPACE=${containerd_cfg.namespace}
SB_CONTAINERD_CNI_PLUGIN_DIR=${containerd_cfg.cni_plugin_dir}
SB_CONTAINERD_NATIVE_NETNS_POOL_ENABLED=${containerd_cfg.native_netns_pool_enabled}

# Managed by Terraform bootstrap: extra_sandboxd_env (global) merged under this
# node's own sandboxd_env. Rendered LAST inside this block so a per-node entry
# wins over anything above it, and written BEFORE the final
# `systemctl restart sandboxd` below — which is the whole point. The previous
# only lever, extra_user_data, runs AFTER that restart, so setting any SB_*
# meant appending to the env file and restarting a second time.
%{ for k, v in sandboxd_env ~}
${k}=${v}
%{ endfor ~}
EOF

sudo tee -a /etc/sandboxd/cluster.env < /tmp/aerolvm-ops.env >/dev/null

# containerd engine needs the CNI bridge+host-local+loopback plugin binaries
# under cni_plugin_dir, or the native netns pool's CNI ADD fails hard on every
# create ("stat /opt/cni/bin/bridge: no such file or directory"). Nothing else
# on the Terraform-provisioned path installs them (install.sh's
# --with-containerd-engine covers the manual path). Gated on the engine so
# docker-default nodes skip it entirely. Idempotent: skipped if bridge exists.
if [ "${container_engine}" = "containerd" ]; then
  cni_dir="${containerd_cfg.cni_plugin_dir}"
  if [ ! -x "$${cni_dir}/bridge" ]; then
    case "$(uname -m)" in
      x86_64|amd64) cni_arch=amd64 ;;
      aarch64|arm64) cni_arch=arm64 ;;
      *) echo "[bootstrap] unsupported arch $(uname -m) for CNI plugins" >&2; exit 1 ;;
    esac
    cni_ver=v1.5.1
    cni_url="https://github.com/containernetworking/plugins/releases/download/$${cni_ver}/cni-plugins-linux-$${cni_arch}-$${cni_ver}.tgz"
    echo "[bootstrap] installing CNI plugins $${cni_ver} ($${cni_arch}) to $${cni_dir}"
    sudo mkdir -p "$${cni_dir}"
    curl -fsSL "$${cni_url}" | sudo tar -xz -C "$${cni_dir}"
    for p in bridge host-local loopback; do
      if [ ! -x "$${cni_dir}/$${p}" ]; then
        echo "[bootstrap] expected $${cni_dir}/$${p} after CNI extract" >&2
        exit 1
      fi
    done
  fi

  # buildkitd powers image builds on the containerd engine (POST /v1/images/build
  # + snapshot-from-Dockerfile). buildctl talks to buildkitd over its default
  # socket (/run/buildkit/buildkitd.sock = SB_CONTAINERD_BUILDKIT_ADDR default);
  # buildkitd's containerd worker writes built images into the aerolvm namespace
  # so the driver runs them directly with no extra pull. docker-default nodes
  # never reach here. Idempotent: install skipped when buildkitd already present.
  if ! command -v buildkitd >/dev/null 2>&1; then
    case "$(uname -m)" in
      x86_64|amd64) bk_arch=amd64 ;;
      aarch64|arm64) bk_arch=arm64 ;;
      *) echo "[bootstrap] unsupported arch $(uname -m) for buildkit" >&2; exit 1 ;;
    esac
    bk_ver=v0.17.2
    bk_url="https://github.com/moby/buildkit/releases/download/$${bk_ver}/buildkit-$${bk_ver}.linux-$${bk_arch}.tar.gz"
    echo "[bootstrap] installing buildkit $${bk_ver} ($${bk_arch})"
    bk_tmp="$(mktemp -d)"
    curl -fsSL "$${bk_url}" | sudo tar -xz -C "$${bk_tmp}"
    sudo install -m 0755 "$${bk_tmp}/bin/buildkitd" /usr/local/bin/buildkitd
    sudo install -m 0755 "$${bk_tmp}/bin/buildctl" /usr/local/bin/buildctl
    rm -rf "$${bk_tmp}"
  fi
  # containerd worker only (no oci worker), pinned to the aerolvm namespace + our
  # containerd socket so builds share the driver's image store. Host networking
  # for RUN steps avoids needing a separate buildkit CNI config.
  if [ ! -f /etc/systemd/system/buildkit.service ]; then
    sudo tee /etc/systemd/system/buildkit.service >/dev/null <<UNIT
[Unit]
Description=BuildKit (aerolvm containerd worker)
Requires=containerd.service
After=containerd.service

[Service]
ExecStart=/usr/local/bin/buildkitd --oci-worker=false --containerd-worker=true --containerd-worker-addr=${containerd_cfg.socket} --containerd-worker-namespace=${containerd_cfg.namespace} --containerd-worker-net=host
Restart=on-failure
Delegate=yes

[Install]
WantedBy=multi-user.target
UNIT
    sudo systemctl daemon-reload
  fi
  sudo systemctl enable --now buildkit.service || echo "[bootstrap] warning: buildkit.service failed to start" >&2
fi

sudo systemctl restart sandboxd

${extra_user_data}

echo "[bootstrap] complete"
