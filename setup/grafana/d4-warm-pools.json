      "description": "Fraction of container creates that MISSED the warm pool and took the cold engine path. Container warm pool is exported under docker_pool_* on containerd nodes (the 'docker' runtime = containerd engine).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(aerolvm_docker_pool_misses_total[5m]) / clamp_min(rate(aerolvm_docker_pool_hits_total[5m]) + rate(aerolvm_docker_pool_misses_total[5m]), 1e-9)",
          "legendFormat": "cold-miss rate",
          "refId": "A"
        }
      ],
      "title": "Container Pool Cold-Miss Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Latency to adopt a ready (warm) container from the pool \u2014 the warm-path cost. Container warm pool is exported under docker_pool_* on containerd nodes (the 'docker' runtime = containerd engine).",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
