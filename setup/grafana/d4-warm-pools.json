  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(aerolvm_host_pressure_sandboxes, instance)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "runtime",
        "type": "custom",
        "query": "containerd,gvisor,wasm,isolate,firecracker,docker",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true
      },
      {
        "name": "scenario",
        "type": "custom",
        "query": "cluster-mixed-benchmark-with-obs,cluster-hetero-benchmark-with-obs",
        "current": {
          "text": "cluster-mixed-benchmark-with-obs",
          "value": "cluster-mixed-benchmark-with-obs"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
