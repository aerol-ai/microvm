{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Per-runtime create latency from the runtime-labeled benchReport pushed to Pushgateway (CM-2). One row per runtime = the capability matrix. Density lives in D6 (native metrics, no runtime label). Headline numbers come from the hetero (metal) soak; t3/mixed rows are connectivity-only (CM-4).",
      "fieldConfig": { "defaults": { "custom": { "align": "auto" }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "showHeader": true, "cellHeight": "sm" },
      "pluginVersion": "11.0.0",
      "targets": [
        { "expr": "aerolvm_bench_create_server_p50_ms", "format": "table", "instant": true, "refId": "A" },
        { "expr": "aerolvm_bench_create_server_p90_ms", "format": "table", "instant": true, "refId": "B" },
        { "expr": "aerolvm_bench_create_server_p99_ms", "format": "table", "instant": true, "refId": "C" },
        { "expr": "aerolvm_bench_create_api_p50_ms", "format": "table", "instant": true, "refId": "D" },
        { "expr": "aerolvm_bench_samples", "format": "table", "instant": true, "refId": "E" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
            "excludeByName": { "Time": true, "job": true, "instance": true, "exported_job": true, "exported_instance": true },
            "renameByName": {
              "runtime": "Runtime",
              "Value #A": "server p50 (ms)",
              "Value #B": "server p90 (ms)",
              "Value #C": "server p99 (ms)",
              "Value #D": "api p50 (ms)",
              "Value #E": "samples (N)"
            }
        } }
      ],
      "title": "Runtime Capability Matrix — create latency (pushed, runtime-labeled)",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Non-cumulative histogram: rate by bucket key — never histogram_quantile.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" }, "stacking": { "mode": "normal", "group": "A" } },
      "targets": [
        { "expr": "sum(rate(aerolvm_create_latency_seconds_bucket[5m])) by (key)", "legendFormat": "{{key}}", "refId": "A" }
      ],
      "title": "Create Latency Shape",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "expr": "sum(rate(aerolvm_docker_pool_hits_total[5m])) / clamp_min(sum(rate(aerolvm_docker_pool_hits_total[5m])) + sum(rate(aerolvm_docker_pool_misses_total[5m])), 1e-9)", "legendFormat": "docker pool", "refId": "A" },
        { "expr": "sum(rate(aerolvm_vmm_pool_acquire_total{key=\"hit\"}[5m])) / clamp_min(sum(rate(aerolvm_vmm_pool_acquire_total{key=\"hit\"}[5m])) + sum(rate(aerolvm_vmm_pool_acquire_total{key=\"miss\"}[5m])), 1e-9)", "legendFormat": "vmm pool", "refId": "B" },
        { "expr": "sum(rate(aerolvm_docker_netns_pool_hits_total[5m])) / clamp_min(sum(rate(aerolvm_docker_netns_pool_hits_total[5m])) + sum(rate(aerolvm_docker_netns_pool_misses_total[5m])), 1e-9)", "legendFormat": "netns pool", "refId": "C" }
      ],
      "title": "Warm Pool Hit Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "expr": "sum by (instance) (rate(aerolvm_create_requests_total[5m]))", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "title": "Create Activity by Node",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["aerolvm", "benchmark", "capability"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "D2 Capability Matrix",
  "uid": "aerolvm-d2-capability",
  "version": 1
}
